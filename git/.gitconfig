# Tips:
#   http://www.git-attitude.fr/2013/04/03/configuration-git/

[user]
    name = Ronan Amicel

[color]
    ui = auto

[alias]
    co = checkout

    s = switch
    sm = !git switch $(git default-branch)
    sc = switch --create

    # Status
    st = status
    sts = status --short --untracked-files=no

    # Commit
    ci = commit
    cia = commit --amend
    ciad = !git commit --amend --date=\"$(LANG=C date)\"
    cii = commit --allow-empty -m\"Initial commit\"

    # Cherry-pick
    cp = cherry-pick

    # Pull
    pr = pull --rebase
    prull = pull --rebase
    poule = pull --rebase

    # Push
    pouche = push
    pm = !git push origin $(git default-branch)
    pt = push --tags

    # Add
    ass = add
    ap = add -p

    # Unstage
    rp = reset HEAD -p

    # Work in progress
    wip = commit --no-verify -m\"Work in progress\"

    # Fixup
    fixup = "!f() { msg=\"fixup ${*}\"; git commit -m\"$msg\"; }; f"

    # Commit all changes to a new branch, then switch back to the current branch
    save = !sh -c 'export PREV=$(git symbolic-ref HEAD|cut -d/ -f3-) && git checkout -b "$1" && git commit -am "$1" && git checkout "$PREV"' -

    # Branches
    br = branch --color
    recent = for-each-ref --count=10 --sort=-committerdate refs/heads/ --format='%(refname:short)'

    # Name of the default branch: origin/HEAD when known (refresh it with
    # `git remote set-head origin -a`), else whichever of main/master exists.
    default-branch = "!f() { b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD); if [ -n \"$b\" ]; then echo \"${b#origin/}\"; return; fi; for c in main master; do if git show-ref --verify --quiet \"refs/heads/$c\" || git show-ref --verify --quiet \"refs/remotes/origin/$c\"; then echo \"$c\"; return; fi; done; echo main; }; f"

    # Log
    l = log
    lp = log -p
    la = log -p -1

    # My commits
    me = log -p --author ronan.amicel
    this-month = !sh -c 'git-this-month.sh'
    last-month = !sh -c 'git-last-month.sh'

    # Commits on this branch and not on the default branch
    lb = "!f() { cd -- \"${GIT_PREFIX:-.}\"; git log HEAD --not \"$(git default-branch)\" \"$@\"; }; f"

    # Parent commit
    parent = log --pretty=%P -n 1

    # Short log (via http://coderwall.com/p/euwpig)
    l = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%Creset' --abbrev-commit

    # Graph log
    lg = log --abbrev-commit --oneline --graph
    lga = log --abbrev-commit --oneline --graph --all

    # Diff
    d = diff
    dc = diff --cached
    di = diff-image

    # Hunk: interactive review-first diff viewer (opt-in; leaves the default pager alone).
    # Call hunk's native commands, not the git pager: GIT_PAGER=less (exported in the shell)
    # outranks core.pager and pager.<cmd>, so a pager-based alias would still open less.
    hdiff = "!f() { cd -- \"${GIT_PREFIX:-.}\"; hunk diff \"$@\"; }; f"
    hshow = "!f() { cd -- \"${GIT_PREFIX:-.}\"; hunk show \"$@\"; }; f"

    # Outgoing commits (hg-like)
    out = !git log $(git rev-parse --abbrev-ref HEAD) --not origin/$(git rev-parse --abbrev-ref HEAD) --
    outp = !git log -p $(git rev-parse --abbrev-ref HEAD) --not origin/$(git rev-parse --abbrev-ref HEAD) --

    # Update the default branch then rebase the current branch onto it
    prb = "!f() { m=$(git default-branch); prev=$(git rev-parse --abbrev-ref HEAD); git co \"$m\" && git pr && git co \"$prev\" && git rebase \"$m\"; }; f"
    prbm = "!f() { m=$(git default-branch); prev=$(git rev-parse --abbrev-ref HEAD); git co \"$m\" && git pr && git co \"$prev\" && git rebase \"$m\" && git co \"$m\" && git rebase \"$prev\"; }; f"

    # Show aliases
    aliases = !git config --get-regexp 'alias.*' | colrm 1 6 | sed 's/[ ]/ = /'
	diff-image = "!f() { cd -- \"${GIT_PREFIX:-.}\"; GIT_DIFF_IMAGE_ENABLED=1 git diff \"$@\"; }; f"

[diff]
    #noprefix = true
    wordRegex = .
    algorithm = patience
    renames = true

[pager]
    diff = riff
    show = riff
    log = riff

[interactive]
    diffFilter = riff --color=on

[fetch]
    recurseSubmodules = on-demand

[grep]
    extendedRegexp = true

[log]
    decorate = true
    noprefix = true
    ; abbrevCommit = true

[pull]
    rebase = merges

[push]
    default = simple

[core]
    excludesfile = ~/.gitignore_global
    attributesfile = ~/.gitattributes
    longpaths = true

[status]
    showuntrackedfiles = all

[credential]
    helper = osxkeychain

[merge]
    conflictstyle = diff3

#[diff "image"]
#    command = /home/ronan/.local/bin/git_diff_image

[init]
	defaultBranch = main
	templateDir = ~/.git-template

[include]
    path = ~/.gitconfig.d/critique
